# --- SD Pulse configuration (this file stays on YOUR PC only) ---

# Active connector: demo | browser | csv | api
SD_CONNECTOR=demo

# --- Browser automation (connector = browser) ---
# PRIMARY: session reuse. Run  python -m app.connectors.login  once, log in
# yourself in the window that opens (handles OTP/CAPTCHA), session is saved.
SD_SESSION_FILE=data/snapdeal_session.json
# FALLBACK: password login (fails if Snapdeal asks for OTP)
SD_EMAIL=
SD_PASSWORD=

# --- Official Snapdeal API (connector = api, only if you have partner access) ---
SD_API_KEY=
SD_API_SECRET=
SD_API_BASE=https://api.snapdeal.com

# --- Keyword rank tracker: comma-separated keywords you want tracked ---
SD_TRACK_KEYWORDS=cotton kurta men,men casual shoes,women saree cotton

# Your seller name/brand as it appears in search results (used by rank tracker)
SD_SELLER_BRAND=

# Poll intervals (minutes)
SD_POLL_FAST=15
SD_POLL_SLOW=360
