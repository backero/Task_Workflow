NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>

# Production connection string — only needed to run scripts/migrate-prod-to-dev.js
# (one-off, read-only against production, copies data into the local backero_dev db).
# Never commit a real value here or in the script itself.
PROD_MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/backero

# JWT — generate real random secrets for every environment, never reuse this example.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_API_KEY=your_api_key

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Document Wallet — Google Drive (reuses the GOOGLE_SERVICE_ACCOUNT_EMAIL / GOOGLE_PRIVATE_KEY
# service account above; only the Drive scope is new, code-side). The service account must be
# shared as Editor on this root folder in Google Drive — copy the folder ID from its URL.
GOOGLE_DRIVE_FOLDER_ID=
# Days-until-expiry threshold for the daily renewal reminder digest (default 30 if unset)
DOCUMENT_REMINDER_DAYS=30

# Google OAuth (login button + Drive connect flow) — leave both unset to disable
# "Continue with Google" entirely (server.js checks GOOGLE_CLIENT_ID before registering the routes).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the authorized redirect URI configured in the Google Cloud Console.
GOOGLE_CALLBACK_URL=https://<your-backend-domain>/api/auth/google/callback

# WhatsApp (Baileys — unofficial WhatsApp Web multi-device client, used for QR-login group
# messaging). Session/auth state is persisted in MongoDB (see src/services/whatsappMongoAuth.js),
# not local disk — no persistent volume needed for this on any host.
# Set to false on local to prevent competing with the deployed server over the same MongoDB session.
WHATSAPP_ENABLED=true

# WhatsApp Cloud API (official Business API — OTP, task/overdue alerts, etc.)
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_BUSINESS_ACCOUNT_ID=
WHATSAPP_CLOUD_OTP_TEMPLATE=
# Any string you choose — must match the "Verify token" entered in Meta App
# Dashboard > WhatsApp > Configuration when registering the webhook callback URL
# (https://<your-backend>/api/whatsapp/webhook). Enables inbound-message auto-capture
# into CRM leads.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Email (OTP / notification fallback) — silently no-ops with a warning log if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS OTP fallback (Fast2SMS)
FAST2SMS_API_KEY=

# Groq (Whisper transcription + LLM summaries — CRM voice-note intake & call-recording comm
# logs — plus general AI chat / CRM assist features)
GROQ_API_KEY=

# Redis — declared for Bull queues but no `new Queue(...)` usage exists in src/ as of this
# writing. Leave unset unless a real queue feature is added.
REDIS_URL=

# This backend's own public URL — used to build the Google Drive OAuth redirect URI
# (src/services/googleDrive.service.js) and as a fallback base for the automation engine.
BACKEND_URL=https://<your-backend-domain>

# Frontend URL — required for CORS (server.js reads this into the allowed-origins list) and
# used as the base for generated links (tracking URLs, WhatsApp message links, etc. — see
# APP_URL below, which overrides this specifically for those links if set separately).
FRONTEND_URL=http://localhost:5173
# Optional override of FRONTEND_URL specifically for user-facing generated links
# (defaults to FRONTEND_URL if unset).
APP_URL=

# Social Media Automation engine (separate Python service, backero-backend-py) — out of scope
# for the DigitalOcean migration; keep pointed at wherever that service currently runs.
SOCIAL_ENGINE_URL=
SOCIAL_ENGINE_ADMIN_KEY=

# Rate Limiting (auth endpoints only — no limit on authenticated API routes)
# AUTH_RATE_LIMIT_MAX=30

# Dev-only: force the cron/automation engine to run outside NODE_ENV=production (local testing).
# FORCE_AUTOMATION=true
