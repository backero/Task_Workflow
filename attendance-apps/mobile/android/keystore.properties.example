# Copy to keystore.properties (gitignored) for LOCAL release-build testing
# only. Real CI/CD release builds use the BACKERO_RELEASE_STORE_FILE /
# BACKERO_RELEASE_STORE_PASSWORD / BACKERO_RELEASE_KEY_ALIAS /
# BACKERO_RELEASE_KEY_PASSWORD environment variables instead (see
# docs/runbooks/deploy.md) so the real production keystore password is never
# written to disk on a developer machine.
storeFile=/absolute/path/to/your-release-key.keystore
storePassword=changeme
keyAlias=backero-release
keyPassword=changeme
